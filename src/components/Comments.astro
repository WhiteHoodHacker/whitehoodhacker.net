---
interface Props {
  theme?: 'light' | 'dark' | 'preferred_color_scheme';
}

const { theme = 'preferred_color_scheme' } = Astro.props;
---

<section class="giscus-container my-6">
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="WhiteHoodHacker/whitehoodhacker.net"
    data-repo-id="MDEwOlJlcG9zaXRvcnkzOTY1Njc2MjQ="
    data-category="Post Comments"
    data-category-id="DIC_kwDOF6MkSM4C8W3Y"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme={theme}
    data-lang="en"
    crossorigin="anonymous"
    async
  ></script>
</section>

<script is:inline>
  // Update giscus theme when dark mode changes
  document.addEventListener('astro:after-swap', () => {
    const isDark = document.documentElement.classList.contains('dark');
    const giscusFrame = document.querySelector('iframe.giscus-frame');
    if (giscusFrame) {
      giscusFrame.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: isDark ? 'dark' : 'light' } } },
        'https://giscus.app'
      );
    }
  });
</script>
